{
  "context": {
    "fileName": [
      "AGENTS.md",
      "GEMINI.md"
    ]
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "read_file",
        "hooks": [
          {
            "type": "command",
            "name": "kit-secrets",
            "command": "bash __KIT_HOOKS__/adapt.sh gemini guard-secrets.sh",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "type": "command",
            "name": "kit-phase",
            "command": "bash __KIT_HOOKS__/adapt.sh gemini guard-phase.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "name": "kit-secrets",
            "command": "bash __KIT_HOOKS__/adapt.sh gemini guard-secrets.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "name": "kit-protected",
            "command": "bash __KIT_HOOKS__/adapt.sh gemini guard-protected.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "name": "kit-frozen",
            "command": "bash __KIT_HOOKS__/adapt.sh gemini frozen-tests.sh",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "name": "kit-prod",
            "command": "bash __KIT_HOOKS__/adapt.sh gemini guard-prod.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "name": "kit-git",
            "command": "bash __KIT_HOOKS__/adapt.sh gemini guard-git.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "name": "kit-pr",
            "command": "bash __KIT_HOOKS__/adapt.sh gemini guard-pr.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "name": "kit-noisy",
            "command": "bash __KIT_HOOKS__/adapt.sh gemini guard-noisy.sh",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "type": "command",
            "name": "kit-fmt",
            "command": "bash __KIT_HOOKS__/adapt.sh gemini post-edit-fmt.sh",
            "timeout": 20000
          }
        ]
      }
    ]
  }
}
