# Merge into .codex/config.toml (project) or ~/.codex/config.toml. Generated by bin/build-adapters.sh; do not edit.
# Role files live next to config.toml under agents/. Multi-agent must be enabled in your Codex version.

[agents]
max_concurrent_threads_per_session = 3   # parallel subagents multiply token use; raise deliberately

[agents.analyst]
description = "Reads a task prompt (ticket or free text) and decides whether it is complete enough to plan; lists gaps, ambiguities and assumptions with a question for each. Use at intake, before any planning."
config_file = "agents/analyst.toml"

[agents.developer]
description = "Implements a task against an agreed design and tests until they pass. Use for the implementation step; it does not decide it is verified and does not weaken tests."
config_file = "agents/developer.toml"

[agents.devsecops]
description = "DevSecOps engineer. Changes CI/CD, container, IaC, deployment and dependency configuration with security in mind, and hardens secrets handling and permissions. Use for pipeline, infra and supply-chain work; it never touches production."
config_file = "agents/devsecops.toml"

[agents.engineer]
description = "Technical design role. Turns an agreed plan into a design with options and trade-offs, an ADR when a decision is made, a race/ordering scenario for high-risk work, and a test strategy. Use before implementation, never to implement."
config_file = "agents/engineer.toml"

[agents.reviewer]
description = "Read-only code reviewer. Reviews a diff against the project's rules and known pitfalls and reports violations. Use for a second opinion before a PR; it never edits code."
config_file = "agents/reviewer.toml"

[agents.scout]
description = "Cheap read-only codebase lookups. Use to find where something is defined or used, list call sites, or summarize a small area, so expensive roles do not spend tokens searching."
config_file = "agents/scout.toml"

[agents.security-auditor]
description = "Read-only security auditor for a diff. Looks for auth bypass, IDOR, injection, secret exposure and unsafe input handling. Use on changes to endpoints, middleware, queries or config."
config_file = "agents/security-auditor.toml"

[agents.spec-reviewer]
description = "Read-only reviewer of a specification document (PRD, ADR, feature spec) against a rubric. Use when the host runs the spec review through run-role.sh instead of EGM; it never edits the document."
config_file = "agents/spec-reviewer.toml"

[agents.test-writer]
description = "Writes tests only, following the project's testing rules. Use to add unit, table-driven or integration tests for a Definition of Done item; it must not change production code."
config_file = "agents/test-writer.toml"

[agents.verifier]
description = "Independent verification gate for spec-driven-dev. Checks a diff against a proposal's Definition of Done, its test strategy and the project's known pitfalls. Use only with the artifacts handed to it, never with the implementer's reasoning."
config_file = "agents/verifier.toml"

[agents.verifier-deep]
description = "Independent verification gate for spec-driven-dev. Checks a diff against a proposal's Definition of Done, its test strategy and the project's known pitfalls. Use only with the artifacts handed to it, never with the implementer's reasoning. Strong-tier variant for high-risk work."
config_file = "agents/verifier-deep.toml"
