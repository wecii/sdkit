# sdkit settings that are yours alone: git-ignored, read after sdkit.env (so anything you set here wins over the team's value).
# Limits, memory behaviour, hosts and models differ per developer; the team's shared settings are in sdkit.env.

# Most subagents running at once; scripts/plan-waves.sh splits any wave larger than this (a positive integer)
MAX_PARALLEL=3

# Cost and hosts (measurement is on for a new setup: the Value Report needs all three; empty = off)
# USAGE_LOG=1 records tokens per agent run in <project-dir>/work/<slug>/usage.jsonl (scripts/usage.sh report)
USAGE_LOG=1
# TELEMETRY=1 records run events (phases, agents, retries, failures, verification) in <project-dir>/work/<slug>/events.jsonl (scripts/telemetry.sh summary). Local only, no prompts.
TELEMETRY=1
# VALUE_REPORT=on prints a Value Report (what the task did, used and saved) when a task ends and a session summary when a session ends; stored in <project-dir>/work/_reports (scripts/report.sh). Reads existing records only, no model call.
VALUE_REPORT=on
# scripts/run-role.sh: host for separate-process roles (claude|codex|opencode|cursor|gemini); the verifier may use another vendor
RUN_ROLE_HOST=
VERIFIER_HOST=
RUN_ROLE_MODEL_LIGHT=
RUN_ROLE_MODEL_STANDARD=
RUN_ROLE_MODEL_STRONG=
# 1 = the session hook injects INDEX.md; 0 = agents read it themselves
MEMORY_AUTOLOAD=1
# most entries, which is also the most INDEX lines injected (a positive integer)
MEMORY_INDEX_MAX=100
# memory.sh stale flags entries not updated for this many days
MEMORY_STALE_DAYS=90
# closeout: ask = the orchestrator lists MEMORY: candidates from work/<slug>/notes.md and you pick; auto = take all; off = none
MEMORY_PROMOTE=ask

# Token budget and subagent limits (all optional; empty = off). Measured from the usage ledger, so they need USAGE_LOG=1 (spawn counts do not).
# Most tokens one task may use (in + out + cache-write over all its agent runs; cache reads are not counted). Warn from TOKEN_BUDGET_WARN_PCT, ask at 100%.
TOKEN_BUDGET_TASK=
TOKEN_BUDGET_WARN_PCT=70
# Most subagent spawns per task. Past it, strict mode asks before the next spawn, guided mode only warns, SDD_MODE=off ignores it.
MAX_SPAWNS=
# Warn when a subagent's final answer is longer than this many lines (the full text belongs in work/<slug>/out/)
SUBAGENT_RESULT_MAX_LINES=

# Routing budgets (F06; all optional, empty = off; they apply when ROUTING=on in sdkit.env). TOKEN_BUDGET_TASK and MAX_SPAWNS above are checked by
# route.sh too. Hard = checked before a run starts, so no further run starts past it; a running process is never cut off. Token limits are hard only
# while every earlier run reported its usage; else advisory. The money limit is always advisory (an estimate from <project-dir>/pricing.json).
# Most tokens one role may use in a task
ROUTE_ROLE_TOKENS=
# Seconds one run may take (hard where the machine has timeout or gtimeout, else only recorded)
ROUTE_TIMEOUT_S=
# USD ceiling, estimated from token usage and your pricing.json; a warning, never a stop
ROUTE_BUDGET_COST=
