# sdkit.local.env: settings that are yours alone. Git-ignored. Read after sdkit.env, so anything set here wins over the team's value.
# Limits, memory behaviour, hosts and models differ per developer; the team's shared settings are in sdkit.env.
#
# Format: every setting has a comment above it saying what it does, its values and its default. "Default" is the value this file ships with;
# when it differs from what the code assumes for an unset key, that is said ("unset = ..."). Empty = off, unless stated otherwise.

# ── Parallelism ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

# Most subagents running at once; scripts/plan-waves.sh splits any wave larger than this. A positive integer. Default: 3
MAX_PARALLEL=3

# on = tasks with disjoint writes may run at the same time (scripts/dispatch.sh, parallel.md). off = run tasks in order. Default: on (unset = on).
PARALLEL=on

# ── Measurement (on for a new setup; the Value Report needs all three) ──────────────────────────────────────────────────────────────

# 1 = record tokens per agent run in <project-dir>/work/<slug>/usage.jsonl (read with scripts/usage.sh report). Default: 1 (unset = off).
USAGE_LOG=1
# 1 = record run events (phases, agents, retries, failures, verification) in <project-dir>/work/<slug>/events.jsonl (scripts/telemetry.sh summary).
# Local only, no prompts. Default: 1 (unset = off).
TELEMETRY=1
# on = print a Value Report (what the task did, used and saved) when a task ends and a session summary when a session ends; stored in
# <project-dir>/work/_reports (scripts/report.sh). Reads existing records only, no model call. Values: on | off. Default: on (unset = off).
VALUE_REPORT=on
# 1 = when a subagent finishes (Claude Code SubagentStop), print "[sdkit] <role> done — in: 12.4k, out: 1.8k, cache hit: 71%". "in" counts all input
# (fresh + cache read + cache write); cache hit = cache read / in. Says "token usage not available" when the host gave no data. Needs no USAGE_LOG.
# Default: 1 (unset = off).
USAGE_LINE=1

# ── Hosts and models for scripts/run-role.sh ────────────────────────────────────────────────────────────────────────────────────────

# Host for separate-process roles. Values: claude | codex | opencode | cursor | gemini. Default: empty = run-role.sh refuses to run until you pass --host or set this.
RUN_ROLE_HOST=
# Host for the verifier; may be another vendor than RUN_ROLE_HOST. Same values. Default: empty = RUN_ROLE_HOST.
VERIFIER_HOST=
# Model per tier for run-role.sh, overriding the registry (core/tiers.env, <project-dir>/models.json). Default: empty = the registry's model.
RUN_ROLE_MODEL_LIGHT=
RUN_ROLE_MODEL_STANDARD=
RUN_ROLE_MODEL_STRONG=

# ── Project memory (on/off and the directory are in sdkit.env) ──────────────────────────────────────────────────────────────────────

# 1 = the session hook injects INDEX.md; 0 = agents read it themselves. Default: 1
MEMORY_AUTOLOAD=1
# Most entries, which is also the most INDEX lines injected. A positive integer. Default: 100
MEMORY_INDEX_MAX=100
# `memory.sh stale` flags entries not updated for this many days. Default: 90
MEMORY_STALE_DAYS=90
# Closeout. Values: ask (the orchestrator lists MEMORY: candidates from work/<slug>/notes.md and you pick) | auto (take all) | off (none). Default: ask.
MEMORY_PROMOTE=ask

# ── Token budget and subagent limits ────────────────────────────────────────────────────────────────────────────────────────────────
# All optional; empty = off. Measured from the usage ledger, so token limits need USAGE_LOG=1 (spawn counts do not).

# Most tokens one task may use (in + out + cache-write over all its agent runs; cache reads are not counted). Default: empty = no limit.
TOKEN_BUDGET_TASK=
# Warn from this percentage of TOKEN_BUDGET_TASK; ask at 100%. Default: 70
TOKEN_BUDGET_WARN_PCT=70
# Most subagent spawns per task. Past it, strict mode asks before the next spawn, guided mode only warns, SDD_MODE=off ignores it. Default: empty = no limit.
MAX_SPAWNS=
# Warn when a subagent's final answer is longer than this many lines (the full text belongs in work/<slug>/out/). Default: empty = no warning.
SUBAGENT_RESULT_MAX_LINES=
# Lines scripts/capped.sh keeps of a command's output (failure lines are kept on top of this); shorter output is printed whole. Default: 40
CAPPED_LINES=40
# 1 = `sdd.sh advance` prints a one-line note at a phase boundary (proposed, green): the state is in files, so a /clear or compaction loses nothing.
# Default: 1 (unset = off).
CONTEXT_HINT=1

# ── Routing budgets (F06) ───────────────────────────────────────────────────────────────────────────────────────────────────────────
# All optional; empty = off. They apply when ROUTING=on in sdkit.env; route.sh also checks TOKEN_BUDGET_TASK and MAX_SPAWNS above.
# Hard = checked before a run starts, so no further run starts past it; a running process is never cut off. Token limits are hard only while
# every earlier run reported its usage, else advisory. The money limit is always advisory (an estimate from <project-dir>/pricing.json).

# Most tokens one role may use in a task. Default: empty = no limit.
ROUTE_ROLE_TOKENS=
# Seconds one run may take (hard where the machine has timeout or gtimeout, else only recorded). Default: empty = no limit.
ROUTE_TIMEOUT_S=
# USD ceiling, estimated from token usage and your pricing.json; a warning, never a stop. Default: empty = no limit.
ROUTE_BUDGET_COST=

# ── Pull requests (scripts/open-pr.sh, used by generate-specs and spec-driven-dev) ─────────────────────────────────────────────────

# Host the PR is opened on. Values: bitbucket | github | gitlab | auto (picked from the origin URL). Default: auto. ":=" keeps a value already set
# in the environment or in the shared sdkit.env, so this line never overrides the team's choice; to force another host on this machine, write PR_HOST=bitbucket.
: "${PR_HOST:=auto}"
# Bitbucket only: the e-mail of your Bitbucket account (Basic auth). Default: empty = `git config user.email`.
: "${BITBUCKET_EMAIL:=}"
# Bitbucket only: your token (a repository/workspace access token "ATCTT..." is sent as Bearer; an Atlassian API token needs BITBUCKET_EMAIL). The ":=" form keeps a
# value you exported in your shell. Your API token / app password. Personal and secret: keep it here (git-ignored), never in sdkit.env. Default: empty = read the token
# from the origin URL (a URL that embeds the credentials), else from the local repo named in PR_TOKEN_REPO. github and gitlab use `gh` / `glab` login instead.
: "${BITBUCKET_TOKEN:=}"
# Bitbucket only: a local repo whose origin URL carries the token, for setups where this repo's own URL has none. Default: empty.
: "${PR_TOKEN_REPO:=}"

# Jira egress (personal): allow = scripts/jira.sh may call the Jira API from this machine. Default: empty = no network call.
# JIRA_EGRESS=allow
# Your Jira API token: either export JIRA_API_TOKEN in your shell, or write it here (this file is git-ignored and personal; jira.sh refuses a token in the
# shared sdkit.env or when this file is not ignored). JIRA_TOKEN_ENV is optional: the NAME of another variable that holds the token (never the token itself).
# JIRA_API_TOKEN=
# JIRA_TOKEN_ENV=JIRA_API_TOKEN
# Your Jira account (Jira Cloud: your e-mail, used for Basic auth; empty = Bearer token, Data Center). Also the name `review.sh accept` records for the
# person who accepts a finding, so set it before accepting anything. Personal: never in the shared sdkit.env. Default: empty.
# JIRA_USER=you@your-company.com
