{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "MultiEdit",
      "Bash(make *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(openspec *)",
      "Bash(jq *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(*/sdd.sh *)",
      "Bash(*/spec.sh *)",
      "Bash(*/review.sh *)",
      "Bash(sdkit prespec *)",
      "Bash(mkdir -p __KIT_DIR__/work/*)",
      "Bash(mkdir -p specs/*)",
      "Bash(mv __KIT_DIR__/work/*)",
      "Bash(mv openspec/changes/*)",
      "Bash(cp __KIT_DIR__/work/*)",
      "Bash(ls __KIT_DIR__/work/*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*credentials*)"
    ]
  },
  "extraKnownMarketplaces": {
    "spec-driven-kit": {
      "source": {
        "source": "git",
        "url": "__MARKETPLACE_URL__"
      }
    }
  },
  "enabledPlugins": {
    "spec-driven-kit@spec-driven-kit": true
  }
}
