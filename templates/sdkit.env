# sdkit.env: settings the whole team shares. Committed. Read by the kit's hooks and scripts (shell `source`).
# Personal settings (limits, memory behaviour, hosts, models) live in sdkit.local.env next to it: git-ignored, read after this file, so it wins.
#
# Format: every setting has a comment above it saying what it does, its values and its default. "Default" is the value this file ships with;
# when it differs from what the code assumes for an unset key, that is said ("unset = ..."). Empty = off / auto-detected, unless stated otherwise.

# ── Project ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

# Install persona: standalone | analyst | developer. Set by `sdkit init --env`; sdkit upgrade keeps it. Default: standalone (the plain spec-driven workflow).
#   analyst    a project-specs repo: writes and reviews specs (no stack, no openspec); pre-specs live in a git-ignored directory
#   developer  a source repo: approved specs come from the specs/ submodule, tasks from Jira (managed execution)
SDKIT_ENV=standalone
# Branch that work branches from and PRs target. Default: detected by init (origin/HEAD, else develop, main, master).
BASE_BRANCH=__BASE_BRANCH__
# Tech stack of the verify engine: generic | go | python | nextjs | react-native | spring-boot. Default: detected by init.
STACK=__STACK__
# Verify command and "diff against base" command. Default: empty = the plugin's own scripts (copy-mode installs fill in project paths).
VERIFY_CMD=
DIFF_BASE_CMD=
# Go only: golangci-lint config. Default: the file init copied next to this one.
LINT_CONFIG=__KIT_DIR__/golangci.yml

# ── Spec-driven workflow gate ───────────────────────────────────────────────────────────────────────────────────────────────────────

# Gate for hooks and git hooks, on every host. Values: strict | guided | off. Default: strict (also when unset).
#   strict  deny code changes / push / PR outside the phase that allows them
#   guided  ask in hooks, warn in git hooks (for adopting the kit gradually)
#   off     no gate
SDD_MODE=strict
# Path globs that are always changeable, comma-separated. Default: empty (nothing extra).
SDD_FREE_GLOBS=
# Test-file globs for the test-first phase, comma-separated. Default: empty = built-in patterns for common stacks.
SDD_TEST_GLOBS=
# Agent contracts: 1 = the Claude Code hook checks every handoff with a `CONTRACT:` line and every subagent's HANDOFF-RESULT line (scripts/contract.sh).
# run-role.sh checks a contracted handoff on any host regardless. Shared, so the whole team uses one handoff format. Default: empty = off.
CONTRACTS=
# Risk floor: the lowest risk a task may carry when its diff touches these paths. Format: level:glob, comma-separated; level = low | medium | high;
# globs like SECRET_GLOBS (a file name or a path). Example: high:services/payments/*,medium:migrations/*.sql,medium:*/auth/*
# Checked when tests go green, when the task is verified and by the CI gate (which reads the base branch's value). Commit it here, not in sdkit.local.env.
# Default: empty = off.
RISK_FLOOR_GLOBS=

# ── Reports ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

# Value Report export: on = when a task ends (or a session that served no task), its report is also written to
# <project-dir>/reports/<task id or session id>.json and .md, so it is committed and reviewable with the work. The working copy stays in work/_reports.
# Values: on | off. Default: on (unset = off).
REPORT_EXPORT=on
# Model id, as written in pricing.json, that every agent run would have used without tiered routing. Shared, so the team compares against one baseline.
# Default: empty = routing savings stay N/A (nothing is assumed).
REPORT_BASELINE_MODEL=

# ── Hosts, tracker, pull requests ───────────────────────────────────────────────────────────────────────────────────────────────────

# OpenCode only: permission key for the shell tool in the role files. Values: shell | bash (older OpenCode releases). Default: shell. Run sync.sh after a change.
OPENCODE_SHELL_KEY=shell
# Ticket tracker. Values: jira | none. Default: none.
TRACKER=none
# Pull-request host for open-pr.sh. Values: bitbucket | github | gitlab | auto (from the origin URL). Default: auto
# (an old setup without this key keeps bitbucket). See docs/hosts.md. Kept as ":=" so an exported PR_HOST wins over this file.
: "${PR_HOST:=auto}"

# ── Protection ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

# Repo-relative path prefixes the agent must ask before editing, comma-separated. Default: empty = none.
PROTECTED_PATHS=
# File globs the agent must never read or write, comma-separated (a file name or a path). Default: .env*,*credentials*,*.pem
SECRET_GLOBS=.env*,*credentials*,*.pem

# ── Context economy ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────

# Commands whose output is long (tests, builds, lint), as comma-separated globs, e.g. "npm test*,go test*,pytest*,*gradlew*".
# The main session then runs them through scripts/capped.sh, which keeps the failure lines and the tail and stores the full log in work/<slug>/out/.
# Every token that enters the session is re-read on each later turn, so this is the cheapest saving there is. Default: empty = off.
NOISY_CMD_PATTERNS=

# ── Optional modules (each is off while its value is empty) ─────────────────────────────────────────────────────────────────────────

# kubectl guard: cluster-name suffixes that are production, comma-separated (matched on the cluster behind the context). Default: empty = guard off.
PROD_KUBE_CLUSTERS=
# Release-branch flow: BASE_BRANCH_MODE=release branches from <RELEASE_BRANCH_PREFIX>* instead of BASE_BRANCH. Default: empty = branch from BASE_BRANCH.
BASE_BRANCH_MODE=
# Prefix of release branches. Default: release/
RELEASE_BRANCH_PREFIX=release/
# Prefix of freeze tags. Default: freeze/
FREEZE_TAG_PREFIX=freeze/
# Environment branches that move only through the project's release tooling: a direct push asks first (ALLOW_PROTECTED_PUSH=1 overrides). Comma-separated. Default: empty = none.
PROTECTED_BRANCHES=

# ── Verify engine: per stack ────────────────────────────────────────────────────────────────────────────────────────────────────────

# STACK=generic only: commands the verify engine runs from the repo root. Default: empty = that step is skipped.
VERIFY_FAST_CMD=
VERIFY_TEST_CMD=
# STACK=python only: prefix for tools, e.g. "uv run" or "poetry run". Default: empty = detected from the lockfile.
PY_RUNNER=
# STACK=go only: directory holding the services. Default: services
SERVICES_DIR=services
# STACK=go only: shared module, and the glob of modules that depend on it. Default: empty = none.
SHARED_MODULE=
DEPENDENT_MODULES_GLOB=
# STACK=go and spring-boot: modules matching this glob hold integration tests against real infrastructure; they are vetted and built but not run.
# Default: tests/* (unset = tests/* for Go, none for Spring Boot; empty = test every module).
INTEGRATION_MODULE_GLOB=tests/*
# Node stacks (nextjs, react-native): package manager. Values: npm | pnpm | yarn | bun. Default: empty = detected from the lockfile.
NODE_PM=
# nextjs: 1 = run `next build` in the full verify. Default: empty = off.
VERIFY_BUILD=
# Spring Boot: build tool. Values: maven | gradle. Default: empty = detected.
JAVA_BUILD_TOOL=
# Host skills to run in addition to reviewer + security-auditor for high risk, space-separated (e.g. "code-review security-review"). Default: empty = none.
EXTRA_REVIEW_SKILLS=

# ── Project memory ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────

# Durable facts, how-tos and small decisions in <project-dir>/$MEMORY_DIR, managed by scripts/memory.sh. Only INDEX.md is loaded into a session;
# entries are read when relevant. Values: 1 = on | empty = off. Default: 1 (init --no-memory writes it empty).
MEMORY=1
# Directory for the entries: relative to <project-dir>, or an absolute path. Default: memory
MEMORY_DIR=memory
# Who sees the entries. Values: commit (the team shares them) | ignore (personal; `sdkit init --memory-vcs` writes the .gitignore line). Default: commit.
MEMORY_VCS=commit

# ── Routing (F06) ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# scripts/route.sh decides adapter, model, tier, budget and run/reuse/retry/escalate for every scripts/run-role.sh run. No model is called to decide,
# and risk floors, mandatory gates and evidence rules are never lowered. Explain a decision without running anything: route.sh explain --role <role>.
# Details: docs/design-routing.md. Budgets and the personal host/model settings are in sdkit.local.env.

# Routing on/off. Values: on | off. Default: on for a new setup (unset = off; off = run-role.sh behaves exactly as before).
ROUTING=on
# Model choice. Values: tiered (by role, risk and tier, from core/tiers.env + <project-dir>/models.json) | fixed (one registry id for every role, for experiments).
# Default: tiered.
ROUTE_POLICY=tiered
# ROUTE_POLICY=fixed only: the registry id every role runs on. Default: empty.
ROUTE_FIXED_MODEL=
# 1 = a delegated task in tasks.md must carry `size: small|medium|large` (the model follows the size); `sdd.sh advance proposed` refuses one without.
# 0 = not required (every task then runs on its role's tier). Applies with ROUTING=on and ROUTE_POLICY=tiered. Default: 1.
ROUTE_REQUIRE_SIZE=1

# Tier of each role. Values: light | standard | strong. The model follows the tier (Claude Code: haiku | sonnet | opus via CLAUDE_MODEL_* in core/tiers.env;
# other hosts: <HOST>_MODEL_* there, or RUN_ROLE_MODEL_* in sdkit.local.env). The values below are the roles' own tiers; change one to move that role.
# A task's size: can still move a single task. verifier, reviewer and security-auditor can go up but never below their own tier
# (a lower value is ignored; `sdkit doctor` says so). High-risk verification stays strong.
AGENT_ANALYST_TIER=standard
AGENT_DEVELOPER_TIER=standard
AGENT_DEVSECOPS_TIER=standard
AGENT_ENGINEER_TIER=strong
AGENT_REVIEWER_TIER=standard
AGENT_SCOUT_TIER=light
AGENT_SECURITY_AUDITOR_TIER=standard
AGENT_TEST_WRITER_TIER=standard
AGENT_VERIFIER_TIER=standard

# 1 = low-risk work roles (developer, test-writer, ...) may run one tier lower (light). Independent roles never go lower.
# Default: 0 (off until benchmark results support it).
ROUTE_DOWNGRADE_LOW=0
# Lowest tier for work and independent roles, per risk. Values: light | standard | strong. High-risk verification is always the verifier's deep tier.
# Default: low=light, medium=light, high=standard.
ROUTE_FLOOR_LOW=light
ROUTE_FLOOR_MEDIUM=light
ROUTE_FLOOR_HIGH=standard
# Other hosts to try, in order, when the chosen host has no compatible model or its CLI is missing, space-separated. Default: empty = none.
ROUTE_FALLBACK_HOSTS=

# Failure handling. Defaults: 2 infrastructure retries (transient, rate limit, timeout), 1 escalation to a stronger tier, stopping at the "strong" tier,
# 4 attempts in all, 10 s backoff.
ROUTE_MAX_RETRIES=2
ROUTE_MAX_ESCALATIONS=1
ROUTE_ESCALATE_TO=strong
ROUTE_MAX_ATTEMPTS=4
ROUTE_BACKOFF_S=10
# Seconds a decided run with no known process counts as still running (duplicate protection); a known process is checked directly. Default: 1800
ROUTE_INFLIGHT_TTL_S=1800
# Per-role preference: ROUTE_PREFER_<ROLE>=<registry id>, e.g. ROUTE_PREFER_DEVELOPER=claude:standard. It must meet the tier the policy needs.
# Default: none set (add the line yourself).

# ── Role-aware environments (SDKIT_ENV=analyst | developer) ───────────────────────────────────────────────────────────────────────────

# Tier of the spec-reviewer role (light | standard | strong). Default: standard.
AGENT_SPEC_REVIEWER_TIER=standard
# Most review rounds per spec before a human decides. Default: 4
SPEC_REVIEW_MAX_ROUNDS=4
# Language of the analyst role's prose and of the specs generate-specs writes (ISO 639-1 code or a name: tr, en, ...). Machine-read markers (READINESS, AC ids,
# review verdicts, file names) stay English. Default: tr (also when unset). Personal override: sdkit.local.env.
ANALYST_LANGUAGE=tr

# Issue tracker for managed execution. Values: jira | empty. Default: empty (the developer env sets jira). The keys below are read only when it is jira;
# all are off until you remove the leading # and set them. Credentials are named here by environment variable, never written in this file.
# TRACKER=jira
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_USER=
# JIRA_PROJECT=
# JIRA_SUBTASK_TYPE=Sub-task
# JIRA_CHANGE_TYPE=
# JIRA_LINK_TYPE=
# JIRA_API_VERSION=3
# JIRA_SEARCH_PATH=
# Status names a managed task moves to: when a spec-change request blocks it, and when its evidence is synced. Defaults: Blocked / In Review.
# JIRA_BLOCKED_STATUS=Blocked
# JIRA_REVIEW_STATUS=In Review
# Replaces scripts/jira.sh for managed execution (tests, or a bridge with the same verbs and exit codes). Default: empty = scripts/jira.sh.
# SDD_JIRA_CMD=
