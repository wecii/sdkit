# sdkit settings the whole team shares: it is committed. Read by the kit's hooks and scripts (shell `source`).
# Personal settings (limits, memory behaviour, hosts and models) go in sdkit.local.env next to it, which is git-ignored and read after this file, so it wins.
# Leave VERIFY_CMD / DIFF_BASE_CMD empty to use the plugin's own scripts; copy-mode installs fill them with project paths.
BASE_BRANCH=__BASE_BRANCH__
STACK=__STACK__
VERIFY_CMD=
DIFF_BASE_CMD=
# Go only: golangci-lint config
LINT_CONFIG=__KIT_DIR__/golangci.yml

# Spec-driven workflow gate (hooks and git hooks, every host). Unset = strict.
#   strict  deny code changes / push / PR outside the phase that allows them (the default)
#   guided  ask in hooks, warn in git hooks (for adopting the kit gradually)
#   off     no gate
SDD_MODE=strict
# Extra path globs always changeable (comma-separated); test-file globs for the test-first phase (empty = defaults for common stacks)
SDD_FREE_GLOBS=
SDD_TEST_GLOBS=
# Agent contracts (optional; empty = off): 1 makes the Claude Code hook check every handoff that carries a `CONTRACT:` line and every subagent answer's
# HANDOFF-RESULT line (scripts/contract.sh). run-role.sh checks a contracted handoff on any host regardless. Shared: the whole team's handoffs use one format.
CONTRACTS=
# Risk floor (optional; empty = off): the lowest risk a task may carry when its diff touches these paths. Comma-separated level:glob, level low|medium|high,
# globs like SECRET_GLOBS (a file name or a path), e.g. RISK_FLOOR_GLOBS=high:services/payments/*,medium:migrations/*.sql,medium:*/auth/*
# Checked when the tests go green and when the task is verified, and by the CI gate, which also reads the base branch's value. Commit it here, not in sdkit.local.env.
RISK_FLOOR_GLOBS=

# Value Report export: on = when a task ends (or a session ends that served no task) its report is also written to <project-dir>/reports/<task id or session id>.json and .md,
# next to the other project files, so it is committed and reviewable with the work. The working copy stays in work/_reports. Empty/off = only work/_reports.
REPORT_EXPORT=on

# Value Report baseline (optional; empty = routing savings stay N/A): the model id, as written in pricing.json, that every agent run would have used without tiered routing.
# Shared on purpose: the whole team compares against the same counterfactual. Nothing is assumed when it is empty.
REPORT_BASELINE_MODEL=

# OpenCode only: permission key for the shell tool in the role files (shell; older OpenCode releases: bash). Set it here, then run sync.sh.
OPENCODE_SHELL_KEY=shell

# Ticket tracker (jira | none) and pull-request host for open-pr.sh: bitbucket | github | gitlab | auto (from the origin URL); see the kit's docs/hosts.md
TRACKER=none
: "${PR_HOST:=auto}"

# Comma-separated repo-relative path prefixes the agent must ask before editing
PROTECTED_PATHS=
SECRET_GLOBS=.env*,*credentials*,*.pem

# Optional modules. Each is off while its value is empty.
# kubectl guard: cluster-name suffixes that are production (matched on the cluster behind the context)
PROD_KUBE_CLUSTERS=
# release-branch flow: set BASE_BRANCH_MODE=release to branch from release/* instead of BASE_BRANCH
BASE_BRANCH_MODE=
RELEASE_BRANCH_PREFIX=release/
FREEZE_TAG_PREFIX=freeze/
PROTECTED_BRANCHES=

# STACK=generic only: commands the verify engine runs from the repo root (empty = skipped)
VERIFY_FAST_CMD=
VERIFY_TEST_CMD=
# STACK=python only: prefix for tools, e.g. "uv run" or "poetry run" (empty = detected from the lockfile)
PY_RUNNER=

# Layout hints for the Go verify engine (STACK=go)
SERVICES_DIR=services
SHARED_MODULE=
DEPENDENT_MODULES_GLOB=
# Go modules matching this glob hold integration tests against real infrastructure: they are vetted and built but not run
INTEGRATION_MODULE_GLOB=tests/*

# Other stacks
# Node stacks (nextjs, react-native): package manager when the lockfile is not enough (npm|pnpm|yarn|bun); `next build` in full verify
NODE_PM=
VERIFY_BUILD=
# Spring Boot: maven|gradle when detection is wrong; modules matching this glob are compiled but their tests are not run
JAVA_BUILD_TOOL=
# (INTEGRATION_MODULE_GLOB above applies to Spring Boot modules too; empty = test every module)
# host skills to run in addition to reviewer + security-auditor for high risk, space separated (for example: code-review security-review)
EXTRA_REVIEW_SKILLS=

# Project memory: durable facts, how-tos and small decisions in <project-dir>/$MEMORY_DIR, managed by scripts/memory.sh. Entries are shared through git.
# MEMORY=1 turns it on (empty = off). Only INDEX.md is loaded into a session; entries are read when relevant.
MEMORY=1
# directory for the entries: relative to <project-dir>, or an absolute path
MEMORY_DIR=memory
# commit = the team shares the entries; ignore = personal (sdkit init --memory-vcs writes the .gitignore line). Change it any time.
MEMORY_VCS=commit

# Routing (F06; on for a new setup, off while ROUTING is not "on"). scripts/route.sh decides adapter, model, tier, budget and run/reuse/retry/escalate for every
# scripts/run-role.sh run; no model is called to decide, and risk floors, mandatory gates and evidence rules are never lowered. Explain a decision
# without running anything:  route.sh explain --role <role>.   Details: docs/design-routing.md. ROUTING=off = run-role.sh behaves exactly as before.
ROUTING=on
# tiered (model by role, risk and tier, from the registry: core/tiers.env + <project-dir>/models.json) | fixed (one registry id for every role, for reproducible experiments)
ROUTE_POLICY=tiered
# With ROUTING=on and ROUTE_POLICY=tiered a delegated task in tasks.md must carry size: small|medium|large (the model follows the size); `sdd.sh advance proposed`
# refuses a task without one. 0 = do not require it (every task then runs on its role's tier).
ROUTE_REQUIRE_SIZE=1
# Tier of each role: light | standard | strong. The model follows the tier (Claude Code: haiku | sonnet | opus, CLAUDE_MODEL_* in the kit's core/tiers.env; other hosts:
# <HOST>_MODEL_* there, or RUN_ROLE_MODEL_* below). The values below are the roles' own tiers; change one to move that role. A task's size: can still move a single task.
# verifier, reviewer and security-auditor can go up but never below their own tier (a lower value is ignored; `sdkit doctor` says so). High-risk verification stays strong.
AGENT_ANALYST_TIER=standard
AGENT_DEVELOPER_TIER=standard
AGENT_DEVSECOPS_TIER=standard
AGENT_ENGINEER_TIER=strong
AGENT_REVIEWER_TIER=standard
AGENT_SCOUT_TIER=light
AGENT_SECURITY_AUDITOR_TIER=standard
AGENT_TEST_WRITER_TIER=standard
AGENT_VERIFIER_TIER=standard
ROUTE_FIXED_MODEL=
# 1 lets low-risk work roles (developer, test-writer, ...) run one tier lower (light). Off until benchmark results support it. Independent roles never go lower.
ROUTE_DOWNGRADE_LOW=0
# Lowest tier for work and independent roles per risk (light|standard|strong). High-risk verification is always the verifier's deep tier.
ROUTE_FLOOR_LOW=light
ROUTE_FLOOR_MEDIUM=light
ROUTE_FLOOR_HIGH=standard
# Other hosts to try, in order, when the chosen host has no compatible model or its CLI is missing (space separated; empty = none)
ROUTE_FALLBACK_HOSTS=
# Failure handling: infrastructure retries (transient, rate limit, timeout), escalations to a stronger tier, the tier to stop at, attempts in all
ROUTE_MAX_RETRIES=2
ROUTE_MAX_ESCALATIONS=1
ROUTE_ESCALATE_TO=strong
ROUTE_MAX_ATTEMPTS=4
ROUTE_BACKOFF_S=10
# Seconds a decided run with no known process counts as still running (duplicate protection); a known process is checked directly
ROUTE_INFLIGHT_TTL_S=1800
# Per-role preference: ROUTE_PREFER_<ROLE>=<registry id> (for example ROUTE_PREFER_DEVELOPER=claude:standard); it must meet the tier the policy needs.
