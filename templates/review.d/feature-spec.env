# Review rubric for a feature spec (read by scripts/review.sh plan feature-spec). Copy to <project-dir>/review.d/feature-spec.env to change it.
# Names are EGM shortnames: reviewer = agents/<name>.md, standard = resources/document_standards/<name>.md of the egm plugin.
REVIEWERS="design_critic structural style implementation_readiness"
STANDARDS="design_critic=feature-spec-standard structural=feature-spec-standard implementation_readiness=implementation-readiness-standard"
CONTEXT=".sdkit/project.md"
