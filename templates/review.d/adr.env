# Review rubric for an ADR (read by scripts/review.sh plan adr). Copy to <project-dir>/review.d/adr.env to change it.
# Names are EGM shortnames: reviewer = agents/<name>.md, standard = resources/document_standards/<name>.md of the egm plugin.
REVIEWERS="design_critic structural style"
STANDARDS="design_critic=feature-spec-standard structural=feature-spec-standard"
CONTEXT=".sdkit/project.md"
